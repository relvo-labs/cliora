# Cliora deployment environment (P4-12). Copy to `.env` and fill in.
#
# There are no real values in this file and there must never be: it is committed, and a
# placeholder that looks like a secret is the one people forget to change. Every variable
# marked REQUIRED has no default — `docker compose up` fails and names it, rather than
# starting on something wrong.

# --- REQUIRED: database ---
POSTGRES_USER=cliora
POSTGRES_PASSWORD=          # REQUIRED. Generate: openssl rand -base64 32
POSTGRES_DB=cliora
# Must match the three above. asyncpg driver, and the host is the compose service name.
CLIORA_DATABASE_URL=postgresql+asyncpg://cliora:CHANGE_ME@postgres:5432/cliora

# --- REQUIRED: secrets ---
# Both are refused at startup if left at the dev defaults while
# CLIORA_ENVIRONMENT=production (Settings.reject_dev_secrets_in_production), so a
# forgotten value fails the deploy instead of shipping a forgeable token.
#   openssl rand -base64 48
CLIORA_JWT_SECRET=          # REQUIRED. Rotating it invalidates every live session.
CLIORA_TOKEN_PEPPER=        # REQUIRED. Rotating it invalidates every enrollment token
                            # AND every node credential: each node must re-enroll.
                            # Treat as a one-way door, not a routine rotation.

# --- REQUIRED: public identity ---
# The HTTPS URL daemons are told to connect back to. It ends up in the installer and in
# every node's config, so changing it later means reconfiguring every node.
CLIORA_PUBLIC_BASE_URL=https://cliora.example.com

# --- REQUIRED: TLS ---
# Host directory containing fullchain.pem and privkey.pem, mounted read-only.
CLIORA_TLS_DIR=/etc/letsencrypt/live/cliora.example.com

# --- Optional: release artifacts ---
# Host directory holding agentd tarballs + checksums.txt, served read-only by
# /api/downloads. Empty CLIORA_ARTIFACTS_DIR disables those endpoints (they answer 404),
# which is the right setting until you actually publish a build.
CLIORA_ARTIFACTS_HOST_DIR=./artifacts
CLIORA_ARTIFACTS_DIR=/srv/artifacts

# --- Optional: metrics ---
# Off by default: an always-on metrics endpoint is a permanent read surface on the
# control plane. Enabling it REQUIRES a token of at least 16 characters, or startup
# fails — the endpoint is never served unauthenticated.
CLIORA_METRICS_ENABLED=false
CLIORA_METRICS_SCRAPE_TOKEN=

# --- Optional: shutdown ---
# Upper bound on the SIGTERM drain. Keep compose's stop_grace_period above it, or SIGKILL
# lands mid-drain and browsers get the unexplained disconnect the drain prevents.
CLIORA_SHUTDOWN_DRAIN_SECONDS=15

# --- Optional: the V2 project layer (ADR 0027) ---
# Off by default, and off means genuinely absent: every /api/projects* path answers
# 404 and the navigation rail is byte-for-byte the one that predates the feature.
# Turning it on gives **every role**, Viewer included, a new read — the project list
# and each project's bound node names and absolute workspace paths. There is no
# per-project membership yet, so two teams sharing one deployment will see each
# other's projects. See docs/release-note-project-layer.md before enabling.
CLIORA_PROJECTS_ENABLED=false
# The ceiling on a session credential's life (V2.1, ADR 0028). The *first* thing that
# ends one is the session ending; this is the backstop for a session left open for days.
CLIORA_SESSION_TOKEN_TTL_H=24

# --- Optional: branding ---
# Baked at build time by Vite. Changing it requires rebuilding the frontend image.
VITE_PRODUCT_NAME=Cliora

# --- Optional: observability profile only ---
GRAFANA_ADMIN_PASSWORD=
