{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["path", "mime", "size", "modified_at"],
  "properties": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^\\.cliora/uploads/[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9A-HJKMNP-TV-Z]{26}\\.(png|jpg|gif|webp)$"},
    "mime": {"enum": ["image/png", "image/jpeg", "image/gif", "image/webp"]},
    "size": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "modified_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
  }
}
