{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["name", "hostname", "os", "os_version", "architecture", "daemon_version", "run_user", "runtimes", "workspace_roots"],
  "properties": {
    "tunnel": {"$ref": "node-tunnel-report.schema.json"},
    "privileged_terminal": {"type": "boolean"},
    "image_upload": {"type": "boolean"},
    "file_upload": {"type": "boolean"},
    "context_projection": {"$comment": "agentd 0.8.0+ can receive a task context pack (ADR 0028). Optional, so a node that predates it registers unchanged and is simply treated as incapable.", "type": "boolean"},
    "agent_runner": {"$comment": "agentd 0.9.0+ can run agent work unattended (ADR 0029). The fourth capability of the same shape, and optional for the same reason: a node that predates it registers unchanged, is treated as incapable, and is simply never offered a run.", "type": "boolean"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "hostname": {"type": "string", "minLength": 1, "maxLength": 255},
    "os": {"type": "string", "minLength": 1, "maxLength": 64},
    "os_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "architecture": {"enum": ["amd64", "arm64"]},
    "daemon_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "run_user": {"type": "string", "minLength": 1, "maxLength": 64},
    "runtimes": {
      "type": "array", "maxItems": 16,
      "items": {"$ref": "runtime-item.schema.json"}
    },
    "workspace_roots": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "is_enabled"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "display_name": {"type": "string", "maxLength": 128},
          "is_enabled": {"type": "boolean"}
        }
      }
    }
  }
}
