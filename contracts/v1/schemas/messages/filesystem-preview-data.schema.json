{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Contract 1.11.0 (ADR 0029). Canonical standard-alphabet base64 of at most 512 KiB (699052 characters). Empty is refused: there is no empty file to preview.",
  "type": "object", "additionalProperties": false,
  "required": ["preview_id", "index", "data"],
  "properties": {
    "preview_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "index": {"type": "integer", "minimum": 0, "maximum": 31},
    "data": {"type": "string", "minLength": 4, "maxLength": 699052, "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  }
}
