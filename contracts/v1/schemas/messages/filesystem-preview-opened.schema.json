{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Contract 1.11.0 (ADR 0029). Either a validated snapshot handle, or an in-band denial with a coarse reason. The mime enum IS the allowlist: image/svg+xml is refused by schema. chunk_count = ceil(size / chunk_size) and width*height <= 16777216 cannot be expressed here; the daemon guarantees them and Central re-checks.",
  "type": "object",
  "required": ["success"],
  "properties": {"success": {"type": "boolean"}},
  "if": {"properties": {"success": {"const": true}}},
  "then": {"$ref": "#/$defs/opened"},
  "else": {"$ref": "#/$defs/denied"},
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?![/~])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"},
    "opened": {
      "type": "object", "additionalProperties": false,
      "required": ["success", "preview_id", "path", "kind", "mime", "size", "modified_at", "chunk_size", "chunk_count"],
      "properties": {
        "success": {"const": true},
        "preview_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
        "path": {"$ref": "#/$defs/path"},
        "kind": {"enum": ["image", "pdf"]},
        "mime": {"enum": ["image/png", "image/jpeg", "image/webp", "image/gif", "application/pdf"]},
        "size": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "modified_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
        "chunk_size": {"const": 524288},
        "chunk_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "width": {"type": "integer", "minimum": 1, "maximum": 8192},
        "height": {"type": "integer", "minimum": 1, "maximum": 8192}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "image"}}},
          "then": {"required": ["width", "height"], "properties": {"mime": {"enum": ["image/png", "image/jpeg", "image/webp", "image/gif"]}}}
        },
        {
          "if": {"properties": {"kind": {"const": "pdf"}}},
          "then": {"properties": {"mime": {"const": "application/pdf"}}, "not": {"anyOf": [{"required": ["width"]}, {"required": ["height"]}]}}
        }
      ]
    },
    "denied": {
      "type": "object", "additionalProperties": false,
      "required": ["success", "path", "error"],
      "properties": {
        "success": {"const": false},
        "path": {"$ref": "#/$defs/path"},
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "reason"],
          "properties": {
            "code": {"enum": ["FILE_PREVIEW_UNSUPPORTED", "FILE_PREVIEW_INVALID", "FILE_PREVIEW_LIMIT", "FILE_DENIED", "FILE_NOT_FOUND", "FILE_PERMISSION_DENIED", "FILE_TOO_LARGE"]},
            "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "size": {"type": "integer", "minimum": 0},
            "limit": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
