{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "request_id", "node_id", "timestamp", "payload"],
  "properties": {
    "version": {"const": 1},
    "type": {"enum": ["session.start", "session.started", "session.start_failed", "session.attach", "session.attached", "session.stop", "session.stopped", "session.list", "session.list_result", "session.recover", "session.status_changed", "terminal.resize", "terminal.detach", "terminal.gap", "terminal.exited", "terminal.error", "terminal.control_acquire", "terminal.control_release", "filesystem.list", "filesystem.entries", "filesystem.read", "filesystem.content", "filesystem.search", "filesystem.search_result", "filesystem.upload", "filesystem.uploaded", "filesystem.store", "filesystem.stored", "context.project", "context.projected", "node.challenge", "node.auth", "node.authenticated", "node.heartbeat", "node.register", "node.registered", "node.system_info", "node.runtime_status", "node.shutdown", "daemon.version", "daemon.doctor", "daemon.doctor_result", "daemon.update", "daemon.update_result", "tunnel.open", "tunnel.opened", "tunnel.close", "tunnel.closed", "tunnel.status", "error"]},
    "request_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "node_id": {"type": "string", "format": "uuid"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "success": {"type": "boolean"},
    "payload": {"type": "object"},
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["INVALID_MESSAGE", "PROTOCOL_VERSION_UNSUPPORTED", "MESSAGE_TYPE_UNSUPPORTED", "FRAME_TOO_LARGE", "INVALID_SESSION", "SESSION_NOT_FOUND", "SESSION_ALREADY_EXISTS", "SESSION_NOT_RUNNING", "SESSION_INVALID_STATE", "SESSION_LIMIT_REACHED", "SESSION_START_FAILED", "RUNTIME_NOT_ALLOWED", "INVALID_TERMINAL_SIZE", "WORKSPACE_INVALID", "WORKSPACE_OUTSIDE_ALLOWED_ROOT", "WORKSPACE_NOT_FOUND", "WORKSPACE_NOT_DIRECTORY", "WORKSPACE_PERMISSION_DENIED", "FILE_NOT_FOUND", "FILE_TOO_LARGE", "FILE_BINARY", "FILE_DENIED", "FILE_PERMISSION_DENIED", "FILE_UPLOAD_TOO_LARGE", "FILE_UPLOAD_UNSUPPORTED_TYPE", "FILE_UPLOAD_QUOTA_EXCEEDED", "FILE_UPLOAD_FAILED", "FILE_UPLOAD_DISABLED", "FILE_EXISTS", "FILE_UPLOAD_NO_SPACE", "NODE_OFFLINE", "NODE_DISABLED", "NODE_AUTH_FAILED", "NODE_BUSY", "RUNTIME_NOT_FOUND", "RUNTIME_DISABLED", "RUNTIME_NOT_EXECUTABLE", "ENROLLMENT_TOKEN_INVALID", "REQUEST_TIMEOUT", "QUEUE_OVERFLOW", "TERMINAL_ALREADY_CONTROLLED", "UPDATE_NOT_ALLOWED", "UPDATE_DOWNLOAD_FAILED", "UPDATE_CHECKSUM_MISMATCH", "UPDATE_HEALTHCHECK_FAILED", "UPDATE_ROLLED_BACK", "UPDATE_IN_PROGRESS", "TUNNEL_PROVIDER_NOT_CONFIGURED", "TUNNEL_PROVIDER_UNAVAILABLE", "TUNNEL_PROVIDER_UNAUTHORIZED", "TUNNEL_PROVIDER_UNTRUSTED", "TUNNEL_PORT_NOT_ALLOWED", "TUNNEL_LIMIT_REACHED", "INTERNAL_ERROR"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 256},
        "details": {"type": "object"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "session.start"}}}, "then": {"properties": {"payload": {"$ref": "messages/session-start.schema.json"}}}},
    {"if": {"properties": {"type": {"enum": ["session.attach", "terminal.resize"]}}}, "then": {"properties": {"payload": {"$ref": "messages/terminal-size.schema.json"}}}},
    {"if": {"properties": {"type": {"enum": ["session.stop", "session.recover", "terminal.detach", "terminal.control_acquire", "terminal.control_release"]}}}, "then": {"properties": {"payload": {"$ref": "messages/session-id.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "session.list"}}}, "then": {"properties": {"payload": {"$ref": "messages/session-list.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "filesystem.list"}}}, "then": {"properties": {"payload": {"$ref": "messages/filesystem-list.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "filesystem.read"}}}, "then": {"properties": {"payload": {"$ref": "messages/filesystem-read.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "filesystem.search"}}}, "then": {"properties": {"payload": {"$ref": "messages/filesystem-search.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "filesystem.upload"}}}, "then": {"properties": {"payload": {"$ref": "messages/filesystem-upload.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "filesystem.uploaded"}}}, "then": {"required": ["success"], "properties": {"success": {"const": true}, "payload": {"$ref": "messages/filesystem-uploaded.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "filesystem.store"}}}, "then": {"properties": {"payload": {"$ref": "messages/filesystem-store.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "filesystem.stored"}}}, "then": {"required": ["success"], "properties": {"success": {"const": true}, "payload": {"$ref": "messages/filesystem-stored.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "context.project"}}}, "then": {"properties": {"payload": {"$ref": "messages/context-project.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "context.projected"}}}, "then": {"required": ["success"], "properties": {"success": {"const": true}, "payload": {"$ref": "messages/context-projected.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "node.challenge"}}}, "then": {"properties": {"payload": {"$ref": "messages/node-challenge.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "node.auth"}}}, "then": {"properties": {"payload": {"$ref": "messages/node-auth.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "node.register"}}}, "then": {"properties": {"payload": {"$ref": "messages/node-register.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "node.heartbeat"}}}, "then": {"properties": {"payload": {"$ref": "messages/node-heartbeat.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "node.runtime_status"}}}, "then": {"properties": {"payload": {"$ref": "messages/node-runtime-status.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "node.system_info"}}}, "then": {"properties": {"payload": {"$ref": "messages/node-system-info.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "daemon.update"}}}, "then": {"properties": {"payload": {"$ref": "messages/daemon-update.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "daemon.update_result"}}}, "then": {"properties": {"payload": {"$ref": "messages/daemon-update-result.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "tunnel.open"}}}, "then": {"properties": {"payload": {"$ref": "messages/tunnel-open.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "tunnel.opened"}}}, "then": {"properties": {"payload": {"$ref": "messages/tunnel-opened.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "tunnel.close"}}}, "then": {"properties": {"payload": {"$ref": "messages/tunnel-id.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "tunnel.closed"}}}, "then": {"properties": {"payload": {"$ref": "messages/tunnel-closed.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "tunnel.status"}}}, "then": {"properties": {"payload": {"$ref": "messages/tunnel-status.schema.json"}}}},
    {"if": {"properties": {"type": {"const": "error"}}}, "then": {"required": ["success", "error"], "properties": {"success": {"const": false}}}},
    {"if": {"properties": {"type": {"enum": ["session.started", "session.attached", "session.stopped"]}}}, "then": {"required": ["success"], "properties": {"success": {"const": true}}}}
  ]
}
