{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cliora.local/traceability/waivers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "waivers"],
  "properties": {
    "schema_version": {"const": 1},
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criteria",
          "release",
          "reason",
          "impact",
          "compensating_controls",
          "owner",
          "approvers",
          "created_at",
          "expires_at",
          "revisit_trigger",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^WVR-[0-9]{4}-[0-9]{3}$"},
          "criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9._-]+\\.AC-[0-9]{2}$"}
          },
          "release": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "compensating_controls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "owner": {"type": "string", "minLength": 1},
          "approvers": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "created_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "revisit_trigger": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "expired", "closed"]},
          "evidence_of_control": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
